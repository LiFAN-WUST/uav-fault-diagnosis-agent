# Public interface configuration example. Never commit a real .env file.
# The public repository does not contain the production agent implementation.

LLM_API_KEY=
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your_chat_model

NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

HOST=127.0.0.1
PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
